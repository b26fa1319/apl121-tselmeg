<?xml version='1.0' encoding='UTF-8'?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value="Topic 13 - Winter Cold" />
        <attribute name="authors" value="AI-assisted learning example" />
        <attribute name="about" value="APL121 Code Quest topic 13. Seven temperatures, Fahrenheit conversion, classification, clothing advice, and minimum search. Native Flowgorithm testing is required before submission." />
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters />
        <body>
            <declare name="celsius" type="Real" array="True" size="7" />
            <declare name="minTemp" type="Real" array="False" size="" />
            <declare name="coldestDay" type="Integer" array="False" size="" />
            <declare name="day" type="Integer" array="False" size="" />
            <declare name="valid" type="Boolean" array="False" size="" />
            <output expression="&quot;TOPIC 13: UVLIIN HUITEN&quot;" newline="True" />
            <output expression="&quot;Enter 7 temperatures, one number per line.&quot;" newline="True" />
            <output expression="&quot;Allowed range: -60 to 20 Celsius, inclusive.&quot;" newline="True" />
            <comment text="1. Өдөр бүрийн хэмийг авна. Зөв хүрээний тоо ортол Do давталт үргэлжилнэ." />
            <for variable="day" start="0" end="6" direction="inc" step="1">
                <do expression="!valid">
                    <output expression="DayName(day) &amp; &quot; Celsius [-60,20]: &quot;" newline="True" />
                    <input variable="celsius[day]" />
                    <assign variable="valid" expression="celsius[day] &gt;= -60 &amp;&amp; celsius[day] &lt;= 20" />
                    <if expression="celsius[day] &lt; -60 || celsius[day] &gt; 20">
                        <then>
                            <output expression="&quot;Invalid range. Enter -60 to 20 Celsius.&quot;" newline="True" />
                        </then>
                        <else />
                    </if>
                </do>
            </for>
            <comment text="2. Хамгийн бага хэмийг хайна. Тэнцүү үед эхний өдрийг хадгална." />
            <assign variable="minTemp" expression="celsius[0]" />
            <assign variable="coldestDay" expression="0" />
            <for variable="day" start="1" end="6" direction="inc" step="1">
                <if expression="celsius[day] &lt; minTemp">
                    <then>
                        <assign variable="minTemp" expression="celsius[day]" />
                        <assign variable="coldestDay" expression="day" />
                    </then>
                    <else />
                </if>
            </for>
            <comment text="3. PrintDayResult дэд алгоритмыг Call блокоор өдөр бүр дуудна." />
            <output expression="&quot;Day | Celsius | Fahrenheit | Category | Clothing advice&quot;" newline="True" />
            <for variable="day" start="0" end="6" direction="inc" step="1">
                <call expression="PrintDayResult(day, celsius[day])" />
            </for>
            <comment text="4. Хамгийн хүйтэн өдөр болон хэмийг хоёр нэгжээр хэвлэнэ." />
            <output expression="&quot;Coldest day: &quot; &amp; DayName(coldestDay)" newline="True" />
            <output expression="&quot;Celsius: &quot; &amp; ToFixed(minTemp, 2)" newline="True" />
            <output expression="&quot;Fahrenheit: &quot; &amp; ToFixed(minTemp * 9.0 / 5.0 + 32.0, 2)" newline="True" />
        </body>
    </function>
    <function name="PrintDayResult" type="None" variable="">
        <parameters>
            <parameter name="day" type="Integer" array="False" />
            <parameter name="celsius" type="Real" array="False" />
        </parameters>
        <body>
            <declare name="fahrenheit" type="Real" array="False" size="" />
            <declare name="category" type="String" array="False" size="" />
            <declare name="advice" type="String" array="False" size="" />
            <comment text="Өдрийн дугаар болон хэмийг параметрээр авч, хүснэгтийн нэг мөрийг хэвлэнэ." />
            <assign variable="fahrenheit" expression="celsius * 9.0 / 5.0 + 32.0" />
            <if expression="celsius &gt;= 0">
                <then>
                    <assign variable="category" expression="&quot;Dulaahan&quot;" />
                    <assign variable="advice" expression="&quot;Hungun kurtka&quot;" />
                </then>
                <else>
                    <if expression="celsius &gt;= -10">
                        <then>
                            <assign variable="category" expression="&quot;Seruuhen&quot;" />
                            <assign variable="advice" expression="&quot;Dulaan kurtka, malgai&quot;" />
                        </then>
                        <else>
                            <if expression="celsius &gt;= -20">
                                <then>
                                    <assign variable="category" expression="&quot;Huiten&quot;" />
                                    <assign variable="advice" expression="&quot;Uvliin kurtka, beelii&quot;" />
                                </then>
                                <else>
                                    <if expression="celsius &gt;= -30">
                                        <then>
                                            <assign variable="category" expression="&quot;Mash huiten&quot;" />
                                            <assign variable="advice" expression="&quot;Davharlaj ums, dulaan gutal&quot;" />
                                        </then>
                                        <else>
                                            <assign variable="category" expression="&quot;Tas huiten&quot;" />
                                            <assign variable="advice" expression="&quot;Mash dulaan huvtsas, gadaa bagasga&quot;" />
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="DayName(day) &amp; &quot; | &quot; &amp; ToFixed(celsius, 2) &amp; &quot; | &quot; &amp; ToFixed(fahrenheit, 2) &amp; &quot; | &quot; &amp; category &amp; &quot; | &quot; &amp; advice" newline="True" />
        </body>
    </function>
    <function name="DayName" type="String" variable="dayText">
        <parameters>
            <parameter name="day" type="Integer" array="False" />
        </parameters>
        <body>
            <declare name="dayText" type="String" array="False" size="" />
            <comment text="0-6 индексийг Даваа-Ням гарагийн нэр болгох туслах функц." />
            <if expression="day == 0">
                <then>
                    <assign variable="dayText" expression="&quot;Davaa&quot;" />
                </then>
                <else>
                    <if expression="day == 1">
                        <then>
                            <assign variable="dayText" expression="&quot;Myagmar&quot;" />
                        </then>
                        <else>
                            <if expression="day == 2">
                                <then>
                                    <assign variable="dayText" expression="&quot;Lkhagva&quot;" />
                                </then>
                                <else>
                                    <if expression="day == 3">
                                        <then>
                                            <assign variable="dayText" expression="&quot;Purev&quot;" />
                                        </then>
                                        <else>
                                            <if expression="day == 4">
                                                <then>
                                                    <assign variable="dayText" expression="&quot;Baasan&quot;" />
                                                </then>
                                                <else>
                                                    <if expression="day == 5">
                                                        <then>
                                                            <assign variable="dayText" expression="&quot;Byamba&quot;" />
                                                        </then>
                                                        <else>
                                                            <assign variable="dayText" expression="&quot;Nyam&quot;" />
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>