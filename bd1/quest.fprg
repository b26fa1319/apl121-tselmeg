<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quest"/>
        <attribute name="authors" value="tslmgalmighty"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-28 08:23:58 PM"/>
        <attribute name="created" value="dHNsbWdhbG1pZ2h0eTtUU0VMTUVHUy1NQUNCT087MjAyNi0xMC0yNzsxMDozMDoxOCBQTTszNzgx"/>
        <attribute name="edited" value="dHNsbWdhbG1pZ2h0eTtUU0VMTUVHUy1NQUNCT087MjAyNi0xMC0yODswODoyMzo1OCBQTTsyNjszOTU4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="dayName" type="String" array="False" size=""/>
            <declare name="celsius" type="Real" array="True" size="7"/>
            <declare name="minTemp" type="Real" array="False" size=""/>
            <declare name="fahrenheit" type="Real" array="False" size=""/>
            <declare name="coldestDay" type="Integer" array="False" size=""/>
            <declare name="day" type="Integer" array="False" size=""/>
            <declare name="valid" type="Boolean" array="False" size=""/>
            <for variable="day" start="0" end="6" direction="inc" step="1">
                <do expression="!valid">
                    <output expression="&quot;Celsius [-60, 20]:&quot;" newline="True"/>
                    <input variable="celsius[day]"/>
                    <assign variable="valid" expression="celsius[day] &gt;= -60 &amp;&amp; celsius[day] &lt;= 20"/>
                    <if expression="celsius[day] &lt; -60 || celsius[day] &gt; 20">
                        <then>
                            <output expression="&quot;Invalid temperature. Enter -60 to 20.&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </do>
            </for>
            <assign variable="minTemp" expression="celsius[0]"/>
            <assign variable="coldestDay" expression="0"/>
            <for variable="day" start="1" end="6" direction="inc" step="1">
                <if expression="celsius[day] &lt; minTemp">
                    <then>
                        <assign variable="minTemp" expression="celsius[day]"/>
                        <assign variable="coldestDay" expression="day"/>
                    </then>
                    <else/>
                </if>
            </for>
            <if expression="coldestDay = 0">
                <then>
                    <assign variable="dayName" expression="&quot;Monday&quot;"/>
                </then>
                <else>
                    <if expression="coldestDay = 1">
                        <then>
                            <assign variable="dayName" expression="&quot;Tuesday&quot;"/>
                        </then>
                        <else>
                            <if expression="coldestDay = 2">
                                <then>
                                    <assign variable="dayName" expression="&quot;Wednesday&quot;"/>
                                </then>
                                <else>
                                    <if expression="coldestDay = 3">
                                        <then>
                                            <assign variable="dayName" expression="&quot;Thursday&quot;"/>
                                        </then>
                                        <else>
                                            <if expression="coldestDay = 4">
                                                <then>
                                                    <assign variable="dayName" expression="&quot;Friday&quot;"/>
                                                </then>
                                                <else>
                                                    <if expression="coldestDay = 5">
                                                        <then>
                                                            <assign variable="dayName" expression="&quot;Saturday&quot;"/>
                                                        </then>
                                                        <else>
                                                            <assign variable="dayName" expression="&quot;Sunday&quot;"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Coldest temperature: &quot; &amp; ToFixed(minTemp, 1) &amp; &quot; C&quot;" newline="True"/>
            <output expression="&quot;Coldest day: &quot; &amp; dayName" newline="True"/>
            <assign variable="fahrenheit" expression="minTemp * 9 / 5 + 32"/>
            <output expression="&quot;Coldest temperature in F: &quot; &amp; ToFixed(fahrenheit, 1) &amp; &quot; F&quot;" newline="True"/>
            <if expression="minTemp &gt;= 0">
                <then>
                    <output expression="&quot;Warm - Light jacket&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="minTemp &gt;= -10">
                        <then>
                            <output expression="&quot;Cool - Warm jacket and hat&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="minTemp &gt;= -20">
                                <then>
                                    <output expression="&quot;Cold - Winter jacket and gloves&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="minTemp &gt;= -30">
                                        <then>
                                            <output expression="&quot;Very cold - Layer clothes and wear warm boots&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Extreme cold - Wear very warm clothes and limit time outside&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <for variable="day" start="0" end="6" direction="inc" step="1">
                <call expression="PrintDayResult(celsius[day], day)"/>
            </for>
        </body>
    </function>
    <function name="PrintDayResult" type="None" variable="">
        <parameters>
            <parameter name="temp" type="Real" array="False"/>
            <parameter name="dayIndex" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="fahrenheit" type="Real" array="False" size=""/>
            <declare name="dayName" type="String" array="False" size=""/>
            <if expression="dayIndex = 0">
                <then>
                    <assign variable="dayName" expression="&quot;Monday&quot;"/>
                </then>
                <else>
                    <if expression="dayIndex = 1">
                        <then>
                            <assign variable="dayName" expression="&quot;Tuesday&quot;"/>
                        </then>
                        <else>
                            <if expression="dayIndex = 2">
                                <then>
                                    <assign variable="dayName" expression="&quot;Wednesday&quot;"/>
                                </then>
                                <else>
                                    <if expression="dayIndex = 3">
                                        <then>
                                            <assign variable="dayName" expression="&quot;Thursday&quot;"/>
                                        </then>
                                        <else>
                                            <if expression="dayIndex = 4">
                                                <then>
                                                    <assign variable="dayName" expression="&quot;Friday&quot;"/>
                                                </then>
                                                <else>
                                                    <if expression="dayIndex = 5">
                                                        <then>
                                                            <assign variable="dayName" expression="&quot;Saturday&quot;"/>
                                                        </then>
                                                        <else>
                                                            <assign variable="dayName" expression="&quot;Sunday&quot;"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="fahrenheit" expression="temp * 9 / 5 + 32"/>
            <output expression="dayName &amp; &quot;: C = &quot; &amp; ToFixed(temp, 1) &amp; &quot;, F = &quot; &amp; ToFixed(fahrenheit, 1)" newline="True"/>
            <if expression="temp &gt;= 0">
                <then>
                    <output expression="&quot;Warm - Light jacket&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="temp &gt;= -10">
                        <then>
                            <output expression="&quot;Cool - Warm jacket and hat&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="temp &gt;= -20">
                                <then>
                                    <output expression="&quot;Cold - Winter jacket and gloves&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="temp &gt;= -30">
                                        <then>
                                            <output expression="&quot;Very cold - Layer clothes and wear warm boots&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Extreme cold - Wear very warm clothes and limit time outside&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
